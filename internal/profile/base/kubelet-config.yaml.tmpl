apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
address: 0.0.0.0
port: 10250
# 只读端口永远关闭：apiserver 走 10250 的认证/授权通道。
readOnlyPort: 0
authentication:
  anonymous:
    enabled: false
  webhook:
    enabled: true
  x509:
    clientCAFile: {{ .ClientCAFile }}
authorization:
  mode: Webhook
cgroupDriver: {{ .KubeletCgroupDriver }}
clusterDomain: {{ .ClusterDomain }}
clusterDNS:
{{- range .KubeletClusterDNS }}
  - {{ . }}
{{- end }}
containerRuntimeEndpoint: {{ .ContainerRuntimeEndpoint }}
# kubemono 不改动 swap：这里显式关掉失败策略，让保留 swap 的节点也能起 kubelet。
failSwapOn: false
healthzBindAddress: 127.0.0.1
healthzPort: 10248
{{- if .KubeletResolvConf }}
resolvConf: {{ .KubeletResolvConf }}
{{- end }}
registerWithTaints:
{{- range .RegisterWithTaints }}
  - key: {{ taintKey . }}
    value: {{ taintValue . | quote }}
    effect: {{ taintEffect . }}
{{- end }}
rotateCertificates: true
staticPodPath: /etc/kubernetes/manifests
