apiVersion: v1
kind: Pod
metadata:
  name: haproxy
  namespace: kube-system
  labels:
    component: local-proxy
    tier: node
  annotations:
    kubemono.io/config-hash: {{ .ConfigHash | quote }}
    kubemono.io/restarted-at: {{ .RestartedAt | quote }}
spec:
  hostNetwork: true
  priorityClassName: system-node-critical
  # worker 上的组件都经 127.0.0.1:{{ .ProxyPort }} 访问 apiserver，
  # 因此本地代理必须在任何节点上都能起来：不设 nodeSelector，容忍所有污点。
  tolerations:
    - operator: Exists
      effect: NoSchedule
    - operator: Exists
      effect: NoExecute
  containers:
    - name: haproxy
      image: {{ .Image | quote }}
      imagePullPolicy: IfNotPresent
      # haproxy 启动时校验配置：配置非法则退出，由 kubelet 按 restartPolicy 重试。
      command: ["haproxy", "-f", {{ .ConfigFile | quote }}, "-db"]
      securityContext:
        capabilities:
          add: ["NET_BIND_SERVICE"]
      livenessProbe:
        httpGet:
          host: 127.0.0.1
          path: /stats
          port: 8404
        initialDelaySeconds: 10
        periodSeconds: 10
        timeoutSeconds: 5
        failureThreshold: 6
      readinessProbe:
        tcpSocket:
          host: 127.0.0.1
          port: {{ .ProxyPort }}
        initialDelaySeconds: 5
        periodSeconds: 10
        timeoutSeconds: 5
        failureThreshold: 3
      volumeMounts:
        - name: haproxy-config
          mountPath: /etc/haproxy
          readOnly: true
  volumes:
    - name: haproxy-config
      hostPath:
        path: /etc/haproxy
        type: Directory
