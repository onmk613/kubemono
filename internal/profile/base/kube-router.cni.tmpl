{
  "cniVersion": "0.4.0",
  "name": "{{ .Name }}",
  "plugins": [
    {
      "type": "bridge",
      "bridge": "kubemono0",
      "isGateway": true,
      "ipMasq": true,
      "hairpinMode": true,
      "forceAddress": false,
{{- if .MTU }}
      "mtu": {{ .MTU }},
{{- end }}
      "ipam": {
        "type": "host-local",
        "ranges": [
          [
            {
              "subnet": "{{ .NodeCIDR }}"
            }
          ]
        ],
        "routes": [
          {
            "dst": "0.0.0.0/0"
          }
        ]
      }
    },
    {
      "type": "portmap",
      "capabilities": {
        "portMappings": true
      },
      "snat": true
    }
  ]
}
